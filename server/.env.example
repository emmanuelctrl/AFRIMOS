# PostgreSQL connection string (Neon, Railway, Supabase, or local)
DATABASE_URL=postgresql://afrimos:afrimos@localhost:5432/afrimos

# Secrets for signing JWTs - use long random strings in production
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_another_random_string_32_chars

# Server
PORT=5000
NODE_ENV=development

# Admin sign-in. The admin account is created on first boot (or first admin
# sign-in) if it does not exist, so a fresh deployment works without running
# the seed. Leave ADMIN_PASSWORD unset to use the built-in default and change
# it later from Admin > Settings; set it here to pick your own from the start.
# An existing admin's password is never overwritten by these — to force it back
# to the default, re-run `npm run seed`.
ADMIN_EMAIL=admin@afrimos.et
ADMIN_PASSWORD=

# Frontend origin for CORS + links inside emails
FRONTEND_URL=http://localhost:3000

# Number of proxy hops in front of this server. Sign-in rate limiting counts
# per client address, so if you deploy behind nginx, a load balancer, Render,
# Fly or similar, set this (usually 1) — otherwise every request looks like it
# came from the proxy and all users share one rate-limit bucket. Leave it unset
# when the server is reached directly.
TRUST_PROXY=

# SMTP settings for outbound email (SendGrid SMTP relay works here).
# Leave SMTP_HOST empty in development to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AFRIMOS <no-reply@afrimos.et>"
